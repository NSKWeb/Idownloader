generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  profiles      Profile[]
  subscriptions Subscription[]
}

model Profile {
  id           String   @id @default(cuid())
  userId       String
  name         String
  fingerprint  Json
  proxy        String?
  cookies      Json
  localStorage Json
  createdAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations Automation[]
  testRuns    TestRun[]

  @@index([userId])
}

model Automation {
  id              String   @id @default(cuid())
  profileId       String
  name            String
  script          String
  recordedActions Json
  createdAt       DateTime @default(now())

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  testRuns TestRun[]

  @@index([profileId])
}

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  tier        String
  yearlyCost  Int
  renewalDate DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TestRun {
  id           String   @id @default(cuid())
  profileId    String
  automationId String
  status       String
  result       Json
  duration     Int
  createdAt    DateTime @default(now())

  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([automationId])
}
